@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/paintmap.Po@am__quote@ # am--include-marker
@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/paintobjects.Po@am__quote@ # am--include-marker
