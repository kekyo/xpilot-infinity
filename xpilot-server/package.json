{
  "name": "xpilot-infinity",
  "description": "XPilot Infinity server and browser client.",
  "version": "0.1.0",
  "author": "XPilot Infinity contributors",
  "homepage": "https://github.com/kekyo/xpilot-infinity",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kekyo/xpilot-infinity"
  },
  "type": "module",
  "bin": {
    "xpilot-infinity": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "COPYING"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "npm --prefix ../xpilot-browser run build && npm run build:runtime",
    "build:runtime": "node --no-experimental-webstorage node_modules/vite/bin/vite.js build",
    "test": "npm run build && vitest run",
    "pack": "npm run build && npm run pack:built",
    "pack:built": "node pack.ts",
    "dependencies": "reskill"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "emsdk-env": "0.12.0",
    "funcity": "1.5.0",
    "prettier-max": ">=1.14.0",
    "resolved-killer": "1.1.0",
    "screw-up": ">=1.32.0",
    "typescript": ">=5.0.0",
    "vite": ">=5.0.0",
    "vitest": ">=1.0.0"
  }
}
